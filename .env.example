# Supabase → Project Settings → API (Data API / API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://twojprojekt.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Klucz szyfrujący klucze API użytkowników (32 losowe bajty w base64).
# Wygeneruj: openssl rand -base64 32
# Nie zmieniaj go po wdrożeniu — zapisane klucze przestałyby się odszyfrowywać.
APP_ENCRYPTION_KEY=

# Opcjonalnie: inny model Claude do analiz (domyślnie claude-sonnet-5-5)
# CLAUDE_MODEL_MAIN=claude-opus-5-5
